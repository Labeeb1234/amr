  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
 <self_collide>true</self_collide>
</gazebo>

<!--****************************************** Mecanum Drive Controller *************************************************************-->
<gazebo>
  <plugin name="inertia_controller" filename="libgazebo_ros_planar_move.so">
    <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=useless</remapping>
    </ros>
    <robot_base_frame>base_footprint</robot_base_frame>
    <publish_odom_tf>false</publish_odom_tf>
    <publish_odom>false</publish_odom>
  </plugin>
</gazebo>
<!--************************************************************* SENSOR Setup (gazebo-classic) *********************************************************-->
<!--IMU (fully processed values)-->
<gazebo reference="imu_link">
  <gravity>true</gravity>
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <visualize>true</visualize>
    <topic>__default_topic__</topic>
    <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
      <ros>
          <remapping>~/out:=imu/data</remapping>
      </ros>
      <topicName>imu</topicName>
      <bodyName>imu_link</bodyName>
      <update_rate_HZ>100.0</update_rate_HZ>
      <gaussianNoise>0.0</gaussianNoise>
      <xyzOffset>0 0 0</xyzOffset>
      <rpyOffset>0 0 0</rpyOffset>
      <frameName>imu_link</frameName>
      <initialOrientationAsReference>false</initialOrientationAsReference>
    </plugin>
    <pose>0 0 0 0 0 0</pose>
  </sensor>
</gazebo>

<!--LIDAR setup-->
<gazebo reference="Intel_Realsense_RPLIDAR_1">
  <sensor name="laser" type="ray">
    <pose> 0 0 0 0 0 0 </pose>
    <visualize>true</visualize>
    <update_rate>10.0</update_rate>
    <ray>
      <scan>
        <horizontal>
            <samples>720</samples>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.2</min> 
        <max>8</max>
      </range>
      </ray>
      <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
            <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>Intel_Realsense_RPLIDAR_1</frame_name>
      </plugin>
  </sensor>
</gazebo>

<!-- Odometry Plugin (based on gazebo ground truth) -->
<gazebo>
  <plugin name="Mecanum_Bot_Odometry" filename="libgazebo_ros_p3d.so">
    <ros>
      <remapping>odom:=unfiltered/odometry</remapping>
    </ros>
    <body_name>base_footprint</body_name>
    <frame_name>odom</frame_name>
    <update_rate>100.0</update_rate>
    <gaussian_noise>0.0001</gaussian_noise>
  </plugin>
</gazebo>

<!-- JOINT STATES SENSORS (Encoder Sensor SETUP) -->
<gazebo>
  <plugin name="joint_states_publisher" filename="libgazebo_ros_joint_state_publisher.so">
    <update_rate>50</update_rate>
    <joint_name>Revolute 1</joint_name>
    <joint_name>Revolute 2</joint_name>
    <joint_name>Revolute 3</joint_name>
    <joint_name>Revolute 4</joint_name>
  </plugin>
</gazebo>


</robot>
